# Transport: "stdio" (default, for local Claude Desktop) or "http" (remote connector)
MCP_TRANSPORT=stdio

# Host/port used when MCP_TRANSPORT=http (served at /mcp)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3001

# User-Agent sent with every request
CRAWLER_USER_AGENT=crawler-mcp/2.0 (+https://github.com/your-org/crawler-mcp)

# Per-request timeout in milliseconds (static fetch + crawl4ai page timeout)
CRAWLER_TIMEOUT_MS=15000

# Max characters of page content returned to the model per page (prevents context blow-up)
CRAWLER_MAX_CHARS=20000

# Where capture_page writes rendered PDFs
CRAWLER_OUTPUT_DIR=captures

# --- Optional: LLM-based extraction (extract_llm tool) ---
# crawl4ai/litellm provider string, e.g. openai/gpt-4o-mini, anthropic/claude-3-5-sonnet
# CRAWLER_LLM_PROVIDER=openai/gpt-4o-mini
# API key for the provider above (or set the provider's own env var, e.g. OPENAI_API_KEY)
# CRAWLER_LLM_API_TOKEN=sk-...
