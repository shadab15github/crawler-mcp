# Transport: "stdio" (default, for local Claude Desktop) or "http" (remote connector)
MCP_TRANSPORT=stdio

# Port used when MCP_TRANSPORT=http
MCP_HTTP_PORT=3001

# User-Agent sent with every request
CRAWLER_USER_AGENT=crawler-mcp/1.0 (+https://github.com/your-org/crawler-mcp)

# Per-request timeout in milliseconds
CRAWLER_TIMEOUT_MS=15000

# Max characters of page content returned to the model per page (prevents context blow-up)
CRAWLER_MAX_CHARS=20000
